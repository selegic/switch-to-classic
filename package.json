{
  "name": "switch-to-classic",
  "version": "1.4.0",
  "description": "Chrome extension that adds a 'Switch to Classic' button to Salesforce Lightning pages, letting administrators and developers jump from Lightning to Salesforce Classic in one click.",
  "private": true,
  "license": "MIT",
  "author": "Selegic India Private Limited",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "onFail": "error",
      "version": ">=24.19.0 <25"
    },
    "packageManager": {
      "name": "pnpm",
      "onFail": "error",
      "version": ">=12.6.0 <13"
    }
  },
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/selegic/switch-to-classic.git"
  },
  "homepage": "https://chromewebstore.google.com/detail/selegic-switch-to-classic/ellmmiehdcccalmmdfpoeeablbpnihac",
  "bugs": {
    "url": "https://github.com/selegic/switch-to-classic/issues"
  },
  "keywords": [
    "salesforce",
    "salesforce-classic",
    "salesforce-lightning",
    "chrome-extension",
    "angular",
    "vite"
  ],
  "scripts": {
    "ng": "ng",
    "start": "pnpm dev",
    "dev": "concurrently -n app,content,worker -c blue,green,yellow \"pnpm dev:app\" \"pnpm dev:content\" \"pnpm dev:worker\"",
    "dev:app": "ng build --watch --configuration development",
    "dev:content": "vite build --watch --config vite.content.config.ts",
    "dev:worker": "vite build --watch --config vite.worker.config.ts",
    "build": "pnpm clean && pnpm build:app && pnpm build:extension",
    "build:app": "ng build --configuration production",
    "build:extension": "vite build --config vite.content.config.ts && vite build --config vite.worker.config.ts",
    "build:production": "pnpm clean && pnpm build:app && pnpm build:extension && pnpm run pack",
    "pack": "cd dist/extension && bestzip ../../extension-build.zip *",
    "clean": "rimraf dist extension-build.zip",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "prettier --check .",
    "fix": "prettier --write .",
    "check:types": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.extension.json --noEmit",
    "verify-build": "node scripts/verify-build.mjs",
    "sync-version": "node scripts/sync-version.mjs"
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.0",
    "@types/chrome": "^0.3.7",
    "bestzip": "^4.0.3",
    "concurrently": "^10.0.6",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.4",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
