{
  "manifest_version": 3,
  "name": "Selegic Switch to Classic",
  "short_name": "Selegic Switch to Classic",
  "version": "1.5.0",
  "description": "A tool for Salesforce administrators and developers to help them switch to Classic mode without any hassle in a single click.",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "scripting", "storage", "webNavigation"],
  "host_permissions": [
    "https://*.lightning.force.com/*",
    "https://*.my.salesforce.com/*",
    "https://*.salesforce.com/*"
  ],
  "icons": {
    "128": "assets/images/button_128.png"
  },
  "action": {
    "default_popup": "index.html#/popup",
    "default_title": "Selegic Switch to Classic"
  },
  "options_ui": {
    "page": "index.html#/options",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "js": ["contentPage.js"],
      "matches": [
        "https://*.lightning.force.com/*",
        "https://*.my.salesforce.com/lightning/*",
        "https://*.salesforce.com/lightning/*"
      ],
      "css": ["content.css"]
    }
  ],
  "background": {
    "service_worker": "serviceWorker.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/images/button_128.png"],
      "matches": [
        "https://*.lightning.force.com/*",
        "https://*.my.salesforce.com/*",
        "https://*.salesforce.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
