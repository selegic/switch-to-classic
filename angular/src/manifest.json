{
  "manifest_version": 3,
  "name": "Switch to Classic Experience",
  "short_name": "Switch to Classic",
  "version": "1.0",
  "description": "Switch to Classic Experience",
  "permissions": [
    "tabs"
  ],
  "icons": {
    "128": "assets/images/icon_128.png"
  },
  "action": {
    "default_popup": "index.html?#/popup",
    "default_title": "Switch to Classic Experience"
  },
  "content_scripts": [
    {
      "js": [
        "contentPage.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "styles.css"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/images/switch-button.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}